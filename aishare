#!/bin/sh
# aishare -- make project files accessible to both the user and LIM_AI_USER
# Usage: aishare [directory]   (defaults to current directory)

owner="${USER:-$(whoami)}"
group="${LIM_AI_USER:-ai}"

store="/home/$group/.gitstore"

# The gitdir top-level state files git rewrites when committing (via
# lockfile+rename or in place). The LLM is the committer of a shared repo,
# so it must own them (protect_gitdirs chowns them to the group), and the
# unexpected-entry reports below treat them as expected LLM-owned entries.
# One list, used for both the chown and the reports.
state_files="HEAD index packed-refs ORIG_HEAD FETCH_HEAD MERGE_HEAD MERGE_MSG COMMIT_EDITMSG AUTO_MERGE CHERRY_PICK_HEAD REVERT_HEAD REVERT_MSG TAG_EDITMSG BISECT_LOG BISECT_START BISECT_NEXT BISECT_BAD BISECT_GOOD BISECT_LEFT BISECT_RIGHT shallow"

# The only command aishare runs as root: the sudoers helper, which fixes the
# chown identities, allows only the operations below, and re-validates every
# path (must stay under /home/$group, no symlink component) -- the rule
# itself cannot be pointed elsewhere. See the helper's header.
helper="/usr/local/bin/aishare-helper"

target="${1:-.}"

# Resolve to absolute path
target="$(cd "$target" 2>/dev/null && pwd -P)" || { echo "ERROR: not a directory: $1" >&2; exit 1; }

# Refuse to operate outside /home/$group, or directly on the store
case "$target" in
    "/home/$group"|"/home/$group"/*) ;;
    *) echo "ERROR: target must be under /home/$group" >&2; exit 1 ;;
esac
case "$target" in
    "$store"|"$store"/*) echo "ERROR: $store is managed by aishare; do not share it directly" >&2; exit 1 ;;
esac

# Git executes code from a gitdir's config (core.hooksPath, credential.helper,
# core.sshCommand, ...) and from its hooks, so the LLM must never be able to
# swap a repo's gitdir for one of its own. That cannot be prevented by
# permissions alone inside a group-writable tree -- the LLM could always
# rename the .git directory away (a checkout dir cannot be sticky without
# breaking normal file moves) -- so aishare uses two layers:
#
# 1. move_gitdir: a checkout's .git directory is moved into a store the group
#    can traverse but not restructure (mirroring its path) and replaced by a
#    "gitdir:" pointer file
#    -- the mechanism git itself uses for worktrees -- pinned immutable
#    with chattr so it cannot be replaced, rewritten, or deleted. The
#    store's path-mirror dirs are 2750 (group traverses, never writes),
#    so the stored gitdir cannot be renamed or deleted; the stored .git
#    subtrees keep the group-writable modes the LLM's commits need,
#    protected in place by layer 2. Before the move, retarget_gitdir
#    re-points at the store location every reference to the gitdir (.git
#    pointers of submodules and linked worktrees in the checkout, and the
#    relative core.worktree values in submodule gitdir configs), so the
#    move leaves nothing dangling. Linked worktrees checked out *outside* the
#    checkout are not visible to that scan, so move_gitdir finishes with
#    'git worktree repair', which re-points them at the moved gitdir.
#
# 2. protect_gitdirs: inside every gitdir (full, nested, submodule, and
#    worktree admin dirs) the sticky bit lets only an entry's owner or the
#    gitdir's owner rename or delete entries, so the LLM cannot move or
#    replace the owner-only-writable config and hooks. New files (lockfiles,
#    loose objects) can still be created, so commits keep working. config,
#    hooks, commondir and config.worktree are pre-created if absent so the
#    LLM cannot create them itself: git reads a gitdir's commondir to find
#    the directory its config, hooks and objects come from (and
#    config.worktree as the worktree's own config when
#    extensions.worktreeConfig is set), so a LLM-planted file at either name
#    would redirect the user's git to an LLM-controlled gitdir. A full
#    gitdir's commondir carries ".", which makes the common
#    directory the gitdir itself, as when the file is absent, and a planted
#    one is replaced with it; in a linked-worktree admin dir the real
#    commondir and gitdir files are verified and made not group-writable.
#    report_unexpected_entries then reports any other top-level file not
#    owned by the user -- the backstop for names the specific protections do
#    not cover.
#
# Separately, disable_planted_hooks (run before ownership is normalized)
# strips the executable bit from any git hook not owned by the user, so a
# hook planted by the LLM in a repo it made cannot run as the user; it is
# frozen, not removed, and the user re-enables a legitimate one with chmod +x.
#
# A gitdir is any directory holding a HEAD file plus objects/ and refs/
# (full, nested, or submodule gitdir) or a commondir file (linked-worktree
# admin dir).

is_gitdir() {
    [ -f "$1/commondir" ] || { [ -d "$1/objects" ] && [ -d "$1/refs" ]; }
}

# Print the resolved target of a real .git pointer file: the first line after
# "gitdir: ", a relative target resolved against the pointer's directory
# verbatim (the caller decides whether to normalize). Prints nothing if $1
# is unreadable or its first line is not a "gitdir: " pointer (a user data
# file merely named .git).
pointer_target() {
    [ -r "$1" ] || return
    p="$(head -n 1 "$1" 2>/dev/null)"
    case "$p" in "gitdir: "*) ;; *) return ;; esac
    t="${p#gitdir: }"
    case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
    printf '%s\n' "$t"
}

# Print the paths of the real .git pointer files under $1; pointer_target
# keeps out data files merely named .git, which must not be chmod'd, pinned,
# or flagged.
git_pointers() {
    find "$1" -type f -name .git 2>/dev/null | while IFS= read -r g; do
        [ -n "$(pointer_target "$g")" ] && printf '%s\n' "$g"
    done
}

# Emit the gitdirs under $1 (full, nested, submodule, and worktree admin
# dirs): the directory holding each HEAD file that is_gitdir accepts.
gitdirs() {
    find "$1" -type f -name HEAD 2>/dev/null | while IFS= read -r head; do
        d=$(dirname "$head")
        is_gitdir "$d" && printf '%s\n' "$d"
    done
}

# sudo wrapper: show sudo's own error and warn (instead of failing silently)
# when the sudoers rule for the command is missing or the command fails, and
# propagate the failure so the caller decides whether to continue or abort.
# Batched sites (find -exec, xargs) carry their own || warnings, and
# move_gitdir's pin has its own specific one.
run_sudo() {
    if ! run_sudo_err="$(sudo "$@" 2>&1)"; then
        [ -n "$run_sudo_err" ] && printf '%s\n' "$run_sudo_err" >&2
        echo "WARNING: 'sudo $*' failed" >&2
        return 1
    fi
}

# Run before ownership is normalized: neutralize git hooks not created by the
# user (e.g. planted by the LLM in a repo it made, before the repo was shared),
# which would otherwise run as the user on the user's next commit. Hooks are
# identified by their ownership -- "not owned by you" -- so this must run
# before fix()'s chown -R re-owns everything. For each planted hook aishare
# takes ownership (via the sudo helper) and strips the executable bit as
# the new owner; protect_gitdirs later freezes it (hooks tree not
# group-writable). The hook is not removed: review it, and if it is legitimate
# restore the executable bit with 'chmod +x'. A symlink not owned by the user
# is not disabled -- chmod would follow it and act on the target, which might
# be the user's own script -- and flagged instead.
disable_planted_hooks() {
    gitdirs "$1" | while IFS= read -r d; do
        find "$d/hooks" -maxdepth 1 -type l ! -name '*.sample' ! -user "$owner" \
              2>/dev/null | while IFS= read -r h; do
            echo "WARNING: $h is a symlink in a git hooks dir and is not owned by you: git would execute its target as you on your next commit -- aishare leaves it in place (disabling it would act on the target) -- review it and delete or replace it" >&2
        done
        find "$d/hooks" -maxdepth 1 -type f -perm -0111 ! -name '*.sample' \
              ! -user "$owner" 2>/dev/null | while IFS= read -r h; do
            # Take ownership (the helper chowns to $owner:$group), then
            # strip the exec bit as the new owner.
            if ! run_sudo "$helper" chown "$h"; then
                echo "WARNING: $h is an executable git hook not owned by you and aishare could NOT disable it (the sudo chown failed -- see the error above): it still runs as you on your next commit -- review it" >&2
                continue
            fi
            if ! chmod a-x "$h" 2>/dev/null; then
                echo "WARNING: $h is an executable git hook not owned by you and aishare could NOT disable it (chmod a-x failed after the chown succeeded): it still runs as you on your next commit -- review it" >&2
                continue
            fi
            echo "WARNING: $h is an executable git hook not owned by you: aishare disabled it (removed the executable bit) and froze it, but did not remove it -- review it, and if it is legitimate restore it with 'chmod +x $h'" >&2
        done
    done
}

# Re-point at $2 every reference to the gitdir $1, to be run before $1 is
# moved to $2: .git pointer files of submodules and linked worktrees in
# the checkout (relative or absolute) are rewritten into $2, and the
# relative core.worktree values in submodule gitdir configs are made
# absolute (they are resolved against the gitdir, which is about to move).
# Only references whose target exists in $1 are rewritten.
retarget_gitdir() {
    old="$1"
    new="$2"
    find "${old%/.git}" \( -path "$old" -prune \) -o -type f -name .git -print 2>/dev/null | \
        while IFS= read -r g; do
        t="$(pointer_target "$g")"
        [ -n "$t" ] || continue
        # lexical normalization (-sm: no symlink following, missing paths OK)
        t="$(realpath -sm "$t")"
        case "$t" in
            "$old") printf 'gitdir: %s\n' "$new" > "$g" ;;
            "$old"/*) [ -d "$t" ] && printf 'gitdir: %s/%s\n' "$new" "${t#"$old"/}" > "$g" ;;
        esac
    done
    find "$old/modules" -type f -name config 2>/dev/null | while IFS= read -r cfg; do
        v=$(awk '/^[ \t]*\[/ { incore = tolower($0) ~ /^\[core\]/ ; next }
                 incore && /^[ \t]*worktree[ \t]*=/ {
                     sub(/^[ \t]*worktree[ \t]*=[ \t]*/, "")
                     print
                     exit }' "$cfg")
        case "$v" in \"*\") v=${v#\"}; v=${v%\"} ;; esac
        case "$v" in
            ''|/*) ;;
            *)
                abs="$(realpath -sm "${cfg%/*}/$v")"
                if [ -d "$abs" ]; then
                    git config --file "$cfg" core.worktree "$abs" 2>/dev/null || \
                        echo "WARNING: could not make core.worktree absolute in $cfg (value: $v, target: $abs)" >&2
                else
                    echo "WARNING: $cfg has a relative core.worktree ($v) resolving to the missing $abs: git in that submodule will break once $old moves -- set core.worktree to the checkout path, then re-run aishare" >&2
                fi
                ;;
        esac
    done
}

# Move $1 (a checkout's .git directory in the group-writable tree) into the
# store, re-pointing its references at the store location first, and replace
# it with a pinned "gitdir:" pointer file. Each failure mode warns specifically:
# by the time a later step fails, retarget_gitdir has already re-pointed the
# in-tree references at $dest, so they would silently dangle otherwise.
move_gitdir() {
    d="$1"
    dest="$store$d"
    if [ -e "$dest" ]; then
        echo "WARNING: $dest already exists; left $d in place. Keep the copy you want and re-run aishare -- to keep the stored one: rm -rf '$d'; printf 'gitdir: %s\n' '$dest' > '$d'; sudo /usr/local/bin/aishare-helper chattr +i '$d' -- to keep this one: delete $dest" >&2
        return 1
    fi
    if ! mkdir -p "${dest%/*}"; then
        echo "WARNING: could not create the $store mirror directory for $d" >&2
        return 1
    fi
    # Harden the mirror dirs (and the store root) to traverse-only for the
    # group now, not only at the end (fix_store does the same): with a
    # group-writable umask, the window in between would let the LLM
    # restructure the store and swap the gitdir at the pinned pointer's
    # destination. Walk up from the leaf; pre-existing parents are re-chmod'd
    # idempotently.
    p="${dest%/*}"
    while [ "$p" != "$store" ]; do
        chmod 2750 "$p" 2>/dev/null
        p="${p%/*}"
    done
    chmod 2750 "$store" 2>/dev/null
    retarget_gitdir "$d" "$dest"
    if ! mv "$d" "$dest"; then
        echo "WARNING: could not move $d into $store; the gitdir was not moved, but in-tree references may already point at $dest -- re-run aishare to retry the move" >&2
        return 1
    fi
    if ! printf 'gitdir: %s\n' "$dest" > "$d"; then
        echo "WARNING: moved $d into $store but could not write the $d pointer, so the checkout is broken -- restore it with: printf 'gitdir: %s\n' '$dest' > '$d'" >&2
        return 1
    fi
    # Re-point any linked worktrees checked out *outside* this checkout, which
    # retarget_gitdir (which only scans the checkout) cannot see; the pointer
    # just written lets git locate the moved gitdir. Run this before the pin
    # below on purpose: repair rewrites stale worktree pointers, and none of
    # its writes should ever be blocked by the immutable flag (in-checkout
    # pointers are already unpinned for this run, and the main pointer is not
    # pinned yet).
    # Best effort: on failure those worktrees stay dangling (check_gitfiles
    # flags any under $target).
    git -C "${d%/.git}" worktree repair >/dev/null 2>&1 || \
        echo "WARNING: 'git worktree repair' failed for ${d%/.git}: linked worktrees checked out outside it may now be dangling -- run it yourself: git -C ${d%/.git} worktree repair; if it fails with a permission error on the .git pointer, unpin it (sudo /usr/local/bin/aishare-helper chattr -i) first, then re-run aishare" >&2
    chmod 640 "$d"
    sudo "$helper" chattr +i "$d" 2>/dev/null || \
        echo "WARNING: could not pin $d immutable (chattr unavailable or unsupported here?): the LLM can then replace or delete this .git pointer; aishare will flag a pointer that no longer points into the store" >&2
}

# Protect gitdir $1's config.worktree: git reads it as
# the worktree's own config when extensions.worktreeConfig is set, so the
# LLM must not be able to create or rewrite it. A symlink is removed rather
# than written through (its target might be outside the store). An existing
# file carrying an executable directive is a plant: it is emptied and
# warned; a clean one (possibly the user's per-worktree config) is kept.
protect_config_worktree() {
    pcw_f="$1"
    if [ -L "$pcw_f" ]; then
        echo "WARNING: $pcw_f is a symlink: git would read its target as this gitdir's per-worktree config, which the LLM could point at a config of its own -- aishare removed it" >&2
        rm -f "$pcw_f"
    elif [ -p "$pcw_f" ] || [ -S "$pcw_f" ]; then
        echo "WARNING: $pcw_f is a pipe or socket, not a regular file: opening it would block this run and git would not read a config from it -- aishare removed it" >&2
        rm -f "$pcw_f"
    fi
    if [ -f "$pcw_f" ]; then
        pcw_keys=$(exec_config_keys "$pcw_f"); pcw_krc=$?
        if [ "$pcw_krc" = 0 ] && [ -n "$pcw_keys" ]; then
            echo "WARNING: $pcw_f (this worktree's own config) carries a git directive that runs a command ($(echo $pcw_keys | tr '\n' ' ')) -- it may be a plant the LLM created -- aishare emptied it: review it and re-add any legitimate per-worktree config" >&2
            : > "$pcw_f" 2>/dev/null
        fi
    else
        # Pre-create (like config and hooks) so the LLM cannot create a plant.
        : > "$pcw_f" 2>/dev/null
    fi
    chmod g-w "$pcw_f" 2>/dev/null
}

# Report (without blocking) the top-level files of gitdir $1 that are not
# owned by the user and are not one of the state files aishare hands to the
# group or a git lock/tmp file. The LLM can create any top-level name in the
# group-writable gitdir, and git only expects the state files and its own
# lock and tmp files there, so an unexpected file -- a commondir or
# config.worktree the LLM planted, or a name no specific check covers -- is
# what this backstop is for; the wrapper's Landlock sandbox bounds what such
# a file can do, the report makes it visible. Directories
# are not reported: git-created ones (logs/, worktrees/, ...) are expected
# LLM-owned, and a directory git does not know is inert.
report_unexpected_entries() {
    find "$1" -maxdepth 1 -type f ! -user "$owner" 2>/dev/null | while IFS= read -r rue_f; do
        rue_b=$(basename "$rue_f")
        rue_allowed=no
        for sf_n in $state_files; do
            [ "$rue_b" = "$sf_n" ] && rue_allowed=yes
        done
        case "$rue_b" in
            *.lock|*.tmp) rue_allowed=yes ;;
        esac
        [ "$rue_allowed" = yes ] && continue
        echo "WARNING: $rue_f is a top-level file in gitdir $1 that is not owned by you and is not a git state, lock or tmp file: git does not expect it there -- review it (it may be a plant the LLM created)" >&2
    done
}

protect_gitdirs() {
    # A worktree/submodule checkout's .git is a file pointing at its gitdir:
    # keep it group-readable (the LLM's git must read it) but owner-only
    # writable. This runs before the move loop, which pins the main pointer
    # it creates (chmod would fail on it), and before pin_gitfiles; new
    # pointers made after this run (worktrees or submodules) are not yet
    # pinned -- re-run aishare to pin them. Only real "gitdir:" pointers are
    # touched, so a user data file merely named .git is left alone.
    git_pointers "$1" | while IFS= read -r g; do
        chmod g-w "$g"
    done
    gitdirs "$1" | while IFS= read -r d; do
        case "$d" in
            "$store"/*) ;;                      # already stored (fix_store pass)
            */.git)
                if ! move_gitdir "$d"; then
                    echo "WARNING: could not move $d into the store (see the specific warning above); re-run aishare after resolving" >&2
                else
                    d="$store$d"
                fi
                ;;
        esac
        # A pipe or socket planted at the config name is removed first:
        # git would open it for reading and block on it, and the name must
        # end up a regular file for git to parse.
        if [ -p "$d/config" ] || [ -S "$d/config" ]; then
            echo "WARNING: $d/config is a pipe or socket, not a regular file: git would block reading it -- aishare removed it" >&2
            rm -f "$d/config"
        fi
        touch "$d/config" 2>/dev/null && chmod g-w "$d/config"
        # Pre-create hooks/ if it is absent (mirroring the config touch above)
        # so the LLM cannot create it and plant an executable hook there; then
        # make the whole tree not group-writable so the LLM cannot modify, add,
        # or remove hooks.
        mkdir -p "$d/hooks" 2>/dev/null && chmod -R g-w "$d/hooks"
        # Git reads a gitdir's commondir file to find the directory its
        # config, hooks and objects come from: a file
        # the LLM planted there would redirect the user's git to an
        # LLM-controlled gitdir, and the safe.directory ownership check
        # covers the gitdir, the work tree and the .git file -- not the
        # common directory. The sticky bit and the not-group-writable mode
        # below keep the LLM from replacing or rewriting the file once the
        # user owns it, so the protection holds between aishare runs.
        if [ -d "$d/objects" ] && [ -d "$d/refs" ]; then
            # A full gitdir never has a commondir of its own -- git writes
            # one only in the linked-worktree admin dirs -- so any that is
            # here is a plant (or a stale one a past chown re-owned):
            # replace its content with ".", which makes the common directory
            # the gitdir itself, exactly as when the file is absent. A
            # symlink is removed rather than written through (its target
            # might be outside the store); a pipe or socket is removed too,
            # since opening it for writing would block the run.
            if [ -L "$d/commondir" ]; then
                echo "WARNING: $d/commondir is a symlink: git would take its config, hooks and objects from wherever its target points, which the LLM could control -- aishare removed it" >&2
                rm -f "$d/commondir"
            elif [ -p "$d/commondir" ] || [ -S "$d/commondir" ]; then
                echo "WARNING: $d/commondir is a pipe or socket, not a regular file: opening it would block this run and git would not read a config from it -- aishare removed it" >&2
                rm -f "$d/commondir"
            elif [ -f "$d/commondir" ] && [ "$(cat "$d/commondir" 2>/dev/null)" != "." ]; then
                echo "WARNING: $d/commondir would make git take its config, hooks and objects from a different gitdir (not $d) -- it may be a plant the LLM created -- aishare replaced its content with '.'; remove any gitdir it named" >&2
            fi
            printf '.\n' > "$d/commondir" 2>/dev/null && chmod g-w "$d/commondir"
            protect_config_worktree "$d/config.worktree"
        else
            # A linked-worktree admin dir (worktrees/<name>/): git's own
            # commondir (naming the common dir) and gitdir (naming the
            # worktree's .git) live here. The LLM can rewrite them in place
            # while the dir is group-writable (it owns the dir right after
            # creating the worktree, until the next aishare re-owns it), so
            # verify the commondir still names the common dir -- canonically
            # "../.." from this location -- and make both files not
            # group-writable.
            case "$d" in
                */worktrees/*)
                    pgd_common="${d%/*}"; pgd_common="${pgd_common%/*}"
                    pgd_res=$(realpath -sm "$d/$(cat "$d/commondir" 2>/dev/null)" 2>/dev/null)
                    if [ "$pgd_res" != "$(realpath -sm "$pgd_common" 2>/dev/null)" ]; then
                        echo "WARNING: $d/commondir does not name the common dir $pgd_common (it named '$(cat "$d/commondir" 2>/dev/null)') -- aishare restored the canonical '../..'" >&2
                        printf '../..\n' > "$d/commondir" 2>/dev/null
                    fi
                    ;;
            esac
            if [ -L "$d/commondir" ] || [ -L "$d/gitdir" ]; then
                echo "WARNING: $d/commondir or $d/gitdir is a symlink, which would redirect this worktree's git to wherever the LLM points it -- aishare removed it; run 'git worktree repair' in the checkout to regenerate the gitdir file" >&2
                rm -f "$d/commondir" "$d/gitdir"
            fi
            chmod g-w "$d/commondir" 2>/dev/null
            chmod g-w "$d/gitdir" 2>/dev/null
            protect_config_worktree "$d/config.worktree"
        fi
        # Git replaces or removes these top-level entries via lockfile+rename
        # or unlink, which the sticky bit only permits for the entry's owner.
        # The LLM is the committer of a shared repo, so it must own them; if
        # the repo owner rewrites one (commit, add, rebase, gc, fetch),
        # re-run aishare. One batched chown covers all of them that exist.
        # -h (no-dereference): an entry may be a symlink the LLM planted in
        # the group-writable gitdir; following it would chown whatever it
        # points at, possibly outside the store. The helper exposes only
        # this form for group-chown, and refuses the batch when a planted
        # symlink is among the names (fail closed).
        pgd_args=""
        for sf_n in $state_files; do
            [ -n "$pgd_args" ] && pgd_args="$pgd_args -o"
            pgd_args="$pgd_args -name $sf_n"
        done
        find "$d" -maxdepth 1 \( $pgd_args \) \
            -exec sudo "$helper" chown -h {} + 2>/dev/null || \
                echo "WARNING: could not hand $d's state files to $group (sudo aishare-helper chown failed): the LLM's next commit in that repo may fail" >&2
        chmod 3770 "$d"
        report_unexpected_entries "$d"
    done
}

# Check every .git pointer under $1 (ownership is the trust signal -- see
# the gate below). A pointer is safe only when it is a real "gitdir: " file
# whose target is an existing directory owned by $owner; a symlink (aishare
# cannot pin it immutable, so the LLM could swap its target), a missing
# target, or a target owned by anyone else is unsafe. A regular file merely
# named .git that is not a "gitdir: " pointer is user data and is ignored.
# Returns 0 if every pointer is safe, 1 if any is unsafe or the check
# itself cannot report. The verdict is only meaningful before the chown -R
# that re-owns the tree to $owner and destroys the signal; run after the
# chown only to flag pointers that appeared during the run.
check_gitfiles() {
    # The marker file carries the "found unsafe" state out of the pipeline's
    # subshell; if it cannot be created, fail closed -- a check that cannot
    # report unsafe must not certify safe.
    unsafe="$(mktemp 2>/dev/null)" || {
        echo "WARNING: could not create the temp file the .git pointer check reports through, so the check cannot run and cannot certify the pointers" >&2
        return 1
    }
    find "$1" \( -type f -o -type l \) -name .git 2>/dev/null | while IFS= read -r g; do
        if [ -L "$g" ]; then
            echo "WARNING: $g is a symlink, which aishare cannot pin immutable: the LLM could replace it with a pointer to a gitdir it controls. Replace it with a real gitdir or a 'gitdir:' pointer file, then re-run aishare" >&2
            echo x >> "$unsafe"
            continue
        fi
        t="$(pointer_target "$g")"
        [ -n "$t" ] || continue                   # data file merely named .git
        if [ -d "$t" ] && [ "$(stat -c %U "$t" 2>/dev/null)" = "$owner" ]; then
            continue                              # safe: $owner-owned gitdir
        fi
        echo "WARNING: $g does not resolve to an existing gitdir owned by you -- the pointer may be stale or was replaced by the LLM: remove any planted gitdir, restore or re-point the pointer (git worktree repair), then re-run aishare" >&2
        echo x >> "$unsafe"
    done
    rc=0
    if [ -s "$unsafe" ]; then rc=1; fi
    rm -f "$unsafe"
    return "$rc"
}

# Print the hooks of gitdir $1 that git would run as the repo owner, one per
# line: executable files, and symlinks (git runs their target), excluding
# samples. The same test disable_planted_hooks uses.
exec_hooks() {
    find "$1/hooks" -maxdepth 1 \( -type f -perm -0111 -o -type l \) ! -name '*.sample' 2>/dev/null
}

# Print the keys of gitdir config $1 that make git run a command, one per
# line.  The key list lives only in the --get-regexp pattern below (single
# source of truth); a few keys are flagged only for certain values -- see
# the post-filter after the pattern.  --includes makes git follow include
# files itself (an unreadable or unparseable include is a git fatal and so
# fails closed); two residuals are handled in the post-filter: a missing
# include target is flagged, since git silently skips it -- that is how a
# plant created after sharing would hide -- and includeIf.* is flagged
# outright, since --file has no gitdir context in which to evaluate its
# conditions.  git config does the parsing (quotes, continuations,
# subsections, key case) and reads only $1, so the runner's own config
# cannot leak in.  Fails closed: an unreadable or unparseable config (the
# latter a git fatal, exit >=2) exits non-zero with no output, so a plant
# that cannot be inspected blocks rather than passes.
exec_config_keys() {
    [ -r "$1" ] || return 1
    rc=0
    keys="$(git config --file "$1" --includes --get-regexp '^(core\.(fsmonitor|hookspath|sshcommand|pager|editor|askpass|gitproxy|alternaterefscommand)|credential(\..+)?\.helper|alias\..+|diff\.(external|.+\.(command|textconv))|merge\..+\.driver|filter\..+\.(clean|smudge)|gpg(\..+)?\.program|gpg\.ssh\.defaultkeycommand|gc\.recentobjectshook|hook\..+\.command|difftool\..+\.cmd|mergetool\..+\.cmd|interactive\.difffilter|pager\..+|guitool\..+\.cmd|browser\..+\.cmd|man\..+\.cmd|instaweb\.(httpd|browser)|imap\.tunnel|include(\.path|if\..+\.path)|protocol\.ext\.allow|remote\..+\.(pushurl|url)|submodule\..+\.update)$' 2>/dev/null)" || rc=$?
    [ "$rc" -ge 2 ] && return 1
    [ -n "$keys" ] || return 0
    cfgdir="${1%/*}"
    [ "$cfgdir" = "$1" ] && cfgdir="."
    printf '%s\n' "$keys" | while IFS= read -r line; do
        key=${line%% *}
        val="${line#* }"
        case "$key" in
            alias.*) case "$val" in '!'*) printf '%s\n' "$key" ;; esac ;;
            remote.*) case "$val" in 'ext::'*) printf '%s\n' "$key" ;; esac ;;
            includeif.*) printf '%s\n' "$key" ;;
            include.path)
                # git followed it (it must exist to be readable); flag a
                # missing target, which git silently skips and the LLM can
                # create later.  Relative values are containing-dir
                # relative, as git resolves them.
                case "$val" in /*) ;; *) val="$cfgdir/$val" ;; esac
                [ -f "$val" ] || printf '%s\n' "$key" ;;
            submodule.*) case "$val" in
                    checkout|rebase|merge) ;;
                    *) printf '%s\n' "$key" ;;
                esac ;;
            *) printf '%s\n' "$key" ;;
        esac
    done
}

# Check one gitdir config file ($1) of gitdir $2 for directives that make
# git run a command; report each as an ERROR and return 1 if any is found or
# the file cannot be read, 0 otherwise. Used by check_gitdirs for config and
# for config.worktree: the latter only takes effect when
# extensions.worktreeConfig is set, but an LLM plant pairs the enabled
# extension (a config key) with an executable directive in config.worktree,
# so both files are checked.
check_config_content() {
    [ -f "$1" ] || return 0
    ccc_keys=$(exec_config_keys "$1"); ccc_krc=$?
    if [ "$ccc_krc" != 0 ]; then
        echo "ERROR: $1 in a gitdir not owned by you could not be read: aishare cannot verify it has no executable directives -- make it readable, then re-run aishare" >&2
        return 1
    fi
    ccc_bad=0
    for ccc_k in $ccc_keys; do
        echo "ERROR: $1 has '$ccc_k', a planted git directive that runs a command as you, in $2, a gitdir not owned by you: remove the key, then re-run aishare" >&2
        ccc_bad=1
    done
    return "$ccc_bad"
}

# Check every gitdir that the upcoming chown would re-own (ownership is the
# trust signal -- see the gate below): the in-tree gitdirs under $1 (bare
# repos, custom-named gitdirs, and any gitdir swapped in place of a stored
# one -- swapped pointers are caught by check_gitfiles) and the store
# itself, which fix_store chowns on every run regardless of $1. $owner-owned
# gitdirs are trusted as-is; $group-owned gitdirs are skipped because fix()
# resets their config and hooks (unlinking the inodes the LLM may have open
# and recreating them fresh). A gitdir owned by anyone else is
# unsafe only when it carries an executable plant surface -- a non-sample
# executable hook or a config directive that runs a command -- which the
# chown would make run as the user. Each plant is reported as an ERROR
# naming the hook or config key. Returns 0 if nothing is unsafe, 1 if
# anything is or the check itself cannot report.
check_gitdirs() {
    # Marker file as in check_gitfiles; fail closed if it cannot be created.
    unsafe="$(mktemp 2>/dev/null)" || {
        echo "ERROR: could not create the temp file the gitdir check reports through, so the check cannot run and cannot certify the gitdirs" >&2
        return 1
    }
    second=""
    case "$store" in
        "$1"/*) ;;                                  # $1 already contains the store
        *) second="$store" ;;
    esac
    for root in "$1" $second; do
        [ -n "$root" ] && [ -d "$root" ] || continue
        gitdirs "$root" | while IFS= read -r d; do
            d_cg_own="$(stat -c %U "$d" 2>/dev/null)"
            [ "$d_cg_own" = "$owner" ] && continue
            # $group-owned gitdirs are reset in fix(): config and
            # hooks are unlinked and recreated with fresh inodes, so any
            # plant the LLM left is removed.
            [ "$d_cg_own" = "$group" ] && continue
            exec_hooks "$d" | while IFS= read -r h; do
                echo "ERROR: $h is a planted git hook in $d, a gitdir not owned by you -- git would run it as you once aishare re-owns it: remove it, then re-run aishare" >&2
                echo x >> "$unsafe"
            done
            check_config_content "$d/config" "$d" || echo x >> "$unsafe"
            check_config_content "$d/config.worktree" "$d" || echo x >> "$unsafe"
        done
    done
    rc=0
    if [ -s "$unsafe" ]; then rc=1; fi
    rm -f "$unsafe"
    return "$rc"
}

# .git pointer files are pinned immutable (chattr +i), which would make the
# recursive chown/chmod below fail with EPERM; unpin them for the duration of
# this fix and re-pin at the end (also pins pointers created meanwhile).
unpin_gitfiles() {
    find "$1" -type f -name .git -exec sudo "$helper" chattr -i {} + || \
        echo "WARNING: could not unpin some .git files (sudo aishare-helper chattr -i failed): the chown/chmod that follow may fail on files that are still pinned" >&2
}

pin_gitfiles() {
    # Pin only real "gitdir:" pointers; a data file merely named .git is left
    # unpinned. unpin_gitfiles still covers every .git file, so a stale
    # immutable bit on such a file from an older aishare run cannot trip the
    # recursive chown/chmod.
    git_pointers "$1" | xargs -d '\n' -r sudo "$helper" chattr +i || \
        echo "WARNING: could not pin some .git pointers immutable (sudo aishare-helper chattr +i failed): the LLM could then replace or delete them" >&2
}

# Probe whether 'sudo chattr +i' actually works on the filesystem holding the
# .git pointers: the binary must exist AND the filesystem must support the
# immutable flag. The probe file goes in the group home (same filesystem, and
# group-writable after any aishare run) rather than $target, which may not be
# writable yet when first sharing an LLM-created repo. Run in the main shell
# before any pinning so the result is a single, up-front warning rather than a
# per-pointer one; if the probe cannot run at all, assume fine -- the
# per-pointer warning in move_gitdir remains as the backstop.
chattr_probe() {
    aishare_probe="$(mktemp "/home/$group/.aishare.chattr.XXXXXX" 2>/dev/null)" || return 0
    if sudo "$helper" chattr +i "$aishare_probe" 2>/dev/null; then
        sudo "$helper" chattr -i "$aishare_probe" 2>/dev/null
        rm -f "$aishare_probe"
        return 0
    fi
    rm -f "$aishare_probe"
    return 1
}

fix() {
    # chown does not revoke file descriptors the LLM opened before
    # the chown, so the LLM could still write through them into the re-owned
    # config. For gitdirs the LLM created, save the remote.* and branch.*
    # settings (dropping ext:: URLs, which run a command), unlink config,
    # config.worktree, and hooks after the chown so the LLM's fds point to
    # deleted inodes, and restore the saved settings after protect_gitdirs
    # recreates the files with fresh inodes.
    fx_llm_tmp="$(mktemp -d 2>/dev/null)" || {
        fx_llm_tmp=""
        echo "WARNING: could not create a temp dir for the config/hook reset: the fd-write-after-chown bypass is not closed for LLM-owned gitdirs this run" >&2
    }
    if [ -n "$fx_llm_tmp" ]; then
        gitdirs "$1" | while IFS= read -r d; do
            [ "$(stat -c %U "$d" 2>/dev/null)" = "$group" ] && printf '%s\n' "$d"
        done > "$fx_llm_tmp/list"
        fx_n=0
        while IFS= read -r d; do
            fx_n=$((fx_n+1))
            [ -f "$d/config" ] && [ -r "$d/config" ] || continue
            git config --file "$d/config" --get-regexp '^(remote\..+\..+|branch\..+\..+)$' 2>/dev/null | \
            while IFS= read -r line; do
                key="${line%% *}"; val="${line#* }"
                case "$key" in
                    remote.*.url|remote.*.pushurl)
                        case "$val" in 'ext::'*) continue ;; esac ;;
                esac
                printf '%s\n' "$line"
            done > "$fx_llm_tmp/cfg.$fx_n"
        done < "$fx_llm_tmp/list"
    fi

    disable_planted_hooks "$1"
    unpin_gitfiles "$1"
    # The rest of the setup -- and the protection it sets up -- only holds if
    # the owner owns the tree, so abort instead of leaving it half-protected.
    if ! run_sudo "$helper" chown -R "$1"; then
        echo "ERROR: aborting: $1 is not fully owned by $owner:$group (see the error above); the remaining steps would not hold -- fix the sudo problem and re-run aishare" >&2
        [ -n "$fx_llm_tmp" ] && rm -rf "$fx_llm_tmp"
        exit 1
    fi
    # Unlink the LLM's config, config.worktree, and hooks so the LLM's open
    # fds (not revoked by chown) point to deleted inodes; protect_gitdirs
    # below recreates them with fresh inodes and verified content.
    if [ -n "$fx_llm_tmp" ] && [ -s "$fx_llm_tmp/list" ]; then
        while IFS= read -r d; do
            [ -d "$d" ] || continue
            rm -f "$d/config" "$d/config.worktree" "$d/commondir" 2>/dev/null
            rm -rf "$d/hooks" 2>/dev/null
            echo "NOTE: $d was created by $group: config and hooks reset (chown does not revoke file descriptors $group may have held open); remotes and branch tracking restored" >&2
        done < "$fx_llm_tmp/list"
    fi
    chmod -R g+rw "$1"
    chmod -R -t "$1"
    find "$1" -type d -exec chmod g+s {} +
    protect_gitdirs "$1"
    # Restore the saved remote.* and branch.* settings into the fresh configs
    # that protect_gitdirs just created.
    if [ -n "$fx_llm_tmp" ] && [ -s "$fx_llm_tmp/list" ]; then
        fx_n=0
        while IFS= read -r d; do
            fx_n=$((fx_n+1))
            cf="$fx_llm_tmp/cfg.$fx_n"
            [ -f "$cf" ] && [ -s "$cf" ] || continue
            # The gitdir may have been moved into the store by
            # protect_gitdirs; resolve the pointer to the real path.
            if [ -f "$d" ] && [ ! -d "$d" ]; then
                d_res="$(pointer_target "$d")"
                [ -n "$d_res" ] && [ -d "$d_res" ] && d="$d_res"
            fi
            [ -f "$d/config" ] || continue
            while IFS= read -r line; do
                key="${line%% *}"
                val="${line#* }"
                git config --file "$d/config" "$key" "$val" 2>/dev/null || \
                    echo "WARNING: could not restore $key in $d/config" >&2
            done < "$cf"
        done < "$fx_llm_tmp/list"
    fi
    [ -n "$fx_llm_tmp" ] && rm -rf "$fx_llm_tmp"
    pin_gitfiles "$1"
}

fix_store() {
    [ -d "$store" ] || return 0
    if ! run_sudo "$helper" chown -R "$store"; then
        echo "ERROR: aborting: $store is not fully owned by $owner:$group (see the error above); the remaining steps would not hold -- fix the sudo problem and re-run aishare" >&2
        exit 1
    fi
    # 2750 on the store's path-mirror dirs (group can traverse, never write),
    # leaving each stored .git subtree alone: it keeps the group-writable
    # modes that let the LLM commit.
    find "$store" -type d -path "$store/*/.git" -prune -o -type d -exec chmod 2750 {} +
    protect_gitdirs "$store"
}

# Warn once, up front, if the .git pointers cannot be pinned immutable on this
# filesystem; they then fall back to owner-only-writable plus check_gitfiles.
if ! chattr_probe; then
    echo "WARNING: 'chattr +i' is not usable on the filesystem holding the .git pointers (no chattr, or the fs lacks the immutable flag): .git pointers cannot be pinned, so the LLM could replace or delete them. Protection then relies on the pointers being owner-only-writable plus check_gitfiles blocking the share on a bad pointer." >&2
fi

# Refuse to share (no chown anywhere) if any git ownership check fails: the
# chowns below would re-own a gitdir and disarm git's ownership check
# (safe.directory), letting a plant in it run as the user. The gate blocks
# only what fix() does not itself neutralize -- a .git pointer to a non-$owner
# gitdir (check_gitfiles), or a gitdir owned by neither $owner nor $group
# (in-tree under $target or in the store) carrying an executable plant: a
# non-sample hook or a config directive that runs a command (check_gitdirs).
# $group-owned (LLM-created) gitdirs are deliberately not blocked: fix()
# re-owns them, then resets their config, config.worktree, commondir and hooks
# removing any such plant and closing the fd-write-after-chown
# bypass. A blocked plant is left in place, inert under the ownership check,
# until the user removes it; the check runs before any chown, while ownership
# still reflects the creator (the LLM cannot chown).

# Suspend the LLM's exec_shell command trees while aishare runs, so the
# LLM cannot race the ownership and permission changes below.
#
# The lock: aishare (as the sharing user) creates /var/tmp/lim.aishare.lock
# and removes it in the EXIT trap -- pure mutual exclusion between
# aishares (lim never reads it; the exec_shell block is the suspension
# below). /var/tmp is sticky, so the LLM cannot unlink or replace the
# user's lock mid-run. An existing lock -- a concurrent aishare, or one
# left by an interrupted run -- aborts this run: wait for it to finish
# and re-run, or remove it if no aishare is running.
case "$(stat -Lc %a /var/tmp 2>/dev/null)" in
    1*[2367]) : ;;  # sticky + world-writable
    *) echo "ERROR: /var/tmp is missing or not sticky and world-writable (mode $(stat -Lc %a /var/tmp 2>/dev/null)): the exec_shell lock cannot be protected there -- make /var/tmp mode 1777 and re-run" >&2
       exit 1 ;;
esac
aishare_lock="/var/tmp/lim.aishare.lock"
if [ -e "$aishare_lock" ]; then
    echo "ERROR: $aishare_lock exists: another aishare is running, or a previous run was interrupted and left the lock behind. Wait for it to finish and re-run, or remove it (rm $aishare_lock) if no aishare is running." >&2
    exit 1
fi
if (set -o noclobber; echo "$$" > "$aishare_lock") 2>/dev/null; then
    :
else
    echo "ERROR: could not write $aishare_lock (another aishare may have created it just now, or it was pre-created): check it and remove it if stale, then re-run" >&2
    exit 1
fi
# Trap the cleanup as soon as the lock exists, not after the last step that
# needs it: every exit from here on -- the ptrace_scope gate, the LOCK
# exchange, the sweep, or an interrupted run -- must release the lock and
# undo the suspension already taken (lim's gate and the stopped trees), or
# the run leaves a stale lock and, once lim has locked, lim itself locked.
# Before the suspension starts the cleanup only removes the lock: the
# aishare_locked gate is not yet "yes" and stopped_pids is still empty.
aishare_cleanup() {
    if [ "$aishare_locked" = yes ]; then
        aishare_unlock_reply=$(aishare_lim_cmd UNLOCK "$lim_live" "$lim_st")
        case "$aishare_unlock_reply" in
            OK) : ;;
            *)
                echo "WARNING: lim did not resume the exec_shell command trees (${aishare_unlock_reply:-no reply}): they stay suspended until the next aishare run while lim is running, or resume them manually: sudo /usr/local/bin/aishare-helper cont \$(pgrep -u $group)" >&2
                ;;
        esac
    fi
    # Resume what the sweep stopped.  Only the pids still alive: the list
    # was taken before aishare's work, and the short-lived marker-carriers
    # it caught (command subshells, their sleep/date children) may have
    # exited since -- a dead pid needs no resume, and the helper refuses a
    # batch that names one, which would strand every live pid in the batch.
    live_pids=""
    for sp_pid in $stopped_pids; do
        [ -d "/proc/$sp_pid" ] && live_pids="$live_pids $sp_pid"
    done
    if [ -n "$live_pids" ]; then
        sudo -n "$helper" cont $live_pids 2>/dev/null ||
            echo "WARNING: some suspended exec_shell processes could not be resumed: they stay suspended until the next aishare run (while lim is running) or 'sudo /usr/local/bin/aishare-helper cont <pids>'" >&2
    fi
    rm -f "$aishare_lock"
}
trap aishare_cleanup EXIT

# The suspension. Every process an exec_shell call started carries an
# open fd to that call's marker file (/tmp/lim_execfd_*, opened as the
# script's first line before any command runs; the fd survives setsid,
# orphaning and exec), so the sweep below (aishare-helper sweep-stop, run
# as root -- under ptrace_scope >= 1 the kernel would not let the sharing
# user read the LLM's /proc/*/fd) stops exactly the processes started by
# exec_shell or its subprocesses and nothing else: lim, the terminal, and
# lim's long-lived services (launched without the script) keep running.
# With lim not running, the sweep is the whole suspension (trees a
# crashed lim left behind, in flight or backgrounded); with lim live it
# adds the setsid'd and orphaned trees that left lim's record. Stopped
# processes are resumed (SIGCONT) in the EXIT trap.
#
# While lim is live, aishare also sends LOCK over lim's Unix socket
# (/var/tmp/lim.query): lim refuses new exec_shell calls (its in-memory
# gate, a bounded wait) and SIGSTOPs the process groups it records in
# memory. The record and the gate live in lim's memory, trustworthy only
# if the LLM cannot ptrace lim, so the run requires
# kernel.yama.ptrace_scope 1-3 (lim warns at startup when it is not). The
# exchange is authenticated both ways: lim requires the peer's
# kernel-attested uid (SO_PEERCRED) to be the sharing user's -- the LLM
# cannot release a suspension it cannot create; aishare requires the
# socket peer to be lim's pid with the starttime snapshotted here -- a
# socket the LLM bound at the same path cannot answer. UNLOCK (EXIT trap)
# reverses the gate and the group stop; if it fails, the trees stay
# suspended until the next aishare run (while lim is running) or a manual
# resume.

# Print "state ppid pgrp" of $1 from /proc/$1/stat. Split on the last ')':
# the comm field can contain spaces and parentheses.
pproc_pids() {
    pp_line=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    pp_rest=${pp_line##*) }            # "state ppid pgrp session ..."
    pp_state=${pp_rest%% *}
    pp_rest=${pp_rest#* }              # "ppid pgrp session ..."
    pp_ppid=${pp_rest%% *}
    pp_rest=${pp_rest#* }              # "pgrp session ..."
    pp_pgrp=${pp_rest%% *}
    printf '%s %s %s\n' "$pp_state" "$pp_ppid" "$pp_pgrp"
}

# Print field 22 (starttime) of /proc/$1/stat: the clock ticks since boot
# the process began, which a process that later reuses the same pid cannot
# share. The reference is braced: this host's /bin/sh (bash) expands a bare
# two-digit positional reference as the one-digit parameter plus the literal
# rest, so bare $20 would return field 2 (ppid) with a "0" appended.
proc_starttime() {
    pst_line=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    pst_rest=${pst_line##*) }
    set -- $pst_rest
    [ $# -ge 20 ] || return 1
    printf '%s\n' "${20}"
}

# Send $1 (LOCK or UNLOCK) to lim (pid $2, whose starttime was snapshotted
# to $3 when aishare started) over lim's Unix socket. Verifies the socket
# peer is the real lim before trusting the answer: the kernel-attested
# SO_PEERCRED pid/uid must match lim's -- a socket the LLM bound at the
# same path cannot pass -- and lim's /proc starttime must still be the
# snapshot -- a killed-and-replaced lim (or a recycled pid) cannot keep
# it. Prints lim's reply line ("OK" or an "ERROR ..." reason); any
# failure prints an ERROR line of its own.
aishare_lim_cmd() {
    python3 - "$1" "$2" "$3" <<'LIM_CMD_PY'
import os, socket, struct, sys

cmd, lim_pid, want_st = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
try:
    with open("/proc/%d/stat" % lim_pid) as f:
        data = f.read()
    if int(data[data.rfind(")") + 2:].split()[19]) != want_st:
        print("ERROR lim (pid %d) is no longer the lim that started (it was restarted or the pid was reused)" % lim_pid)
        sys.exit(0)
    lim_uid = os.stat("/proc/%d" % lim_pid).st_uid
except Exception:
    print("ERROR lim (pid %d) is gone" % lim_pid)
    sys.exit(0)
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect("/var/tmp/lim.query")
    p_pid, p_uid, p_gid = struct.unpack(
        "iii", s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                            struct.calcsize("iii")))
    if (p_pid, p_uid) != (lim_pid, lim_uid):
        print("ERROR the socket peer (pid %d uid %d) is not lim (pid %d uid %d)" % (p_pid, p_uid, lim_pid, lim_uid))
        sys.exit(0)
    s.sendall(cmd.encode("ascii") + b"\n")
    buf = b""
    while not buf.endswith(b"\n"):
        b = s.recv(4096)
        if not b:
            break
        buf += b
    s.close()
    print(buf.decode("ascii", "replace").strip() or "ERROR lim closed the connection without replying")
except OSError as e:
    print("ERROR lim is not reachable at /var/tmp/lim.query (%s)" % (e.strerror or e))
LIM_CMD_PY
}

# Find the live lim (exactly one, or abort) and, while it is live, take
# the LOCK over the query socket: lim then refuses new exec_shell calls at
# its gate and SIGSTOPs the process groups it records in memory. The record
# and the gate are trustworthy only while the LLM cannot ptrace lim, so a
# live lim requires kernel.yama.ptrace_scope 1-3 (lim itself warns at
# startup when it is not). With no live lim there is nothing to LOCK: the
# marker sweep below is the whole suspension -- the trees a dead lim left
# behind (its exit cleanup then did not run).
lim_live=""
for l_p in $(pgrep -u "$group" -x lim 2>/dev/null); do
    l_ids=$(pproc_pids "$l_p") || continue
    [ "${l_ids%% *}" = Z ] && continue
    if [ -n "$lim_live" ]; then
        echo "ERROR: more than one live lim process ($lim_live and $l_p): the stateful design assumes one -- stop the extras and re-run aishare" >&2
        exit 1
    fi
    lim_live="$l_p"
done
lim_st=""
aishare_locked=no
if [ -n "$lim_live" ]; then
    l_scope=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null)
    case "$l_scope" in
        1|2|3) : ;;
        *)
            echo "ERROR: kernel.yama.ptrace_scope is '${l_scope:-unset}' (need 1-3): the $group user can then ptrace lim and rewrite the suspension record and gate in lim's memory, so aishare cannot trust the LOCK. Set it (sudo sysctl kernel.yama.ptrace_scope=1) and re-run" >&2
            exit 1 ;;
    esac
    lim_st=$(proc_starttime "$lim_live") || {
        echo "ERROR: could not read lim's starttime from /proc/$lim_live/stat (lim may have just died): re-run aishare" >&2
        exit 1; }
    aishare_lock_reply=$(aishare_lim_cmd LOCK "$lim_live" "$lim_st")
    case "$aishare_lock_reply" in
        OK) aishare_locked=yes ;;
        *)
            echo "ERROR: lim did not lock: $aishare_lock_reply -- the exec_shell command trees could not be suspended, so aishare is aborting" >&2
            exit 1 ;;
    esac
fi

# Stop the marker-carrying processes, via the helper (root): under
# ptrace_scope >= 1 the kernel would not let the sharing user read the
# LLM's /proc/*/fd. The helper prints the pids it stopped, for the EXIT
# trap's resume.
if ! stopped_pids="$(sudo -n "$helper" sweep-stop)"; then
    echo "ERROR: the exec_shell suspension sweep failed ('sudo $helper sweep-stop' -- check the sudo setup, the helper's error is above): the command trees would race the ownership changes, so aishare is aborting" >&2
    exit 1
fi

bad=0
check_gitfiles "$target" || bad=1
check_gitdirs "$target" || bad=1
if [ "$bad" = 1 ]; then
    echo "ERROR: refusing to share $target: git ownership verification failed (see above); chowning would re-own a gitdir you do not own and let its hooks or config run as you. Remove the flagged plant(s) -- or scope aishare to a subdirectory that does not contain them -- then re-run aishare" >&2
    exit 1
fi

if [ "$target" = "/home/$group" ]; then
    # Fix the home dir itself (not recursively) so the AI can create new
    # top-level entries, then fix each child, skipping .ssh and the store
    if ! run_sudo "$helper" chown "$target"; then
        echo "ERROR: aborting: $target is not owned by $owner:$group (see the error above); the remaining steps would not hold -- fix the sudo problem and re-run aishare" >&2
        exit 1
    fi
    chmod g+rw "$target"
    chmod -t "$target"
    chmod g+s "$target"
    for entry in "$target"/* "$target"/.*; do
        case "$(basename "$entry")" in
            .|..|.ssh|.gitstore) continue ;;
        esac
        [ -e "$entry" ] || continue
        [ -L "$entry" ] && continue
        fix "$entry"
    done
else
    fix "$target"
fi
fix_store
# Post-chown verification only: the tree is already re-owned, so blocking
# now would be too late; this flags pointers that appeared during the run
# (e.g. a new worktree) for the next run to pin and verify.
check_gitfiles "$target"

