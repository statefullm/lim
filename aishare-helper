#!/bin/sh
# aishare-helper -- the only command aishare and the git re-share wrapper
# may run as root. It replaces the per-command sudoers rules, whose trailing
# /home/ai/* glob matched '/', '..' and spaces, so e.g. 'chown ai:ai
# /home/ai/../../etc/passwd' was allowed: any code running as the sharing
# user then had root on arbitrary paths.
#
# The helper re-validates every path itself and refuses to run the operation
# at all if any path
#   - contains a '..' component (refused in the raw argument: the lexical
#     normalization below does not follow symlinks, but the kernel resolves
#     a '..' after a symlink component to the target's parent), or
#   - leaves /home/$GROUP (an absolute jump), or
#   - has a symlink component (checked per component),
# so the operations can only ever touch the real directory tree under
# /home/$GROUP (which must be a real directory, as aishare's store layout
# requires). The identities chown is allowed to set are fixed below, never
# taken from the arguments, and the only operations are the ones aishare
# and the wrapper use:
#
#   aishare-helper chown -R PATH...   chown -R USER:GROUP PATH...
#   aishare-helper chown -h PATH...   chown -h GROUP:GROUP PATH...
#   aishare-helper chown PATH         chown -h USER:GROUP PATH (no-dereference)
#   aishare-helper chattr +i PATH...  chattr +i PATH...
#   aishare-helper chattr -i PATH...  chattr -i PATH...
#   aishare-helper stop PID...        kill -STOP (GROUP-owned PIDs only)
#   aishare-helper cont PID...        kill -CONT (GROUP-owned PIDs only)
#
# Install root-owned and unreadable/unwritable by everyone else (the LLM
# user shares $GROUP and can modify anything the group can write):
#   sudo install -m 0700 aishare-helper /usr/local/bin/aishare-helper
# plus one sudoers rule:
#   $USER ALL=(root) NOPASSWD: /usr/local/bin/aishare-helper
# Set USER and GROUP below to your users if they differ.
#
# Residual race: validation and exec are not atomic, and the group can
# rename entries in a group-writable directory in between. Every chown
# form is no-dereference (-R is GNU -P; -h and the plain form chown -h),
# so a swapped-in symlink is chowned as a link, never its target. chattr
# has no no-dereference mode, so a symlink swapped for a .git pointer
# inside the unpin window makes chattr act on its target: at most pinning
# or unpinning an arbitrary file (a DoS, reversible with real sudo, no
# escalation).

# The two identities chown is allowed to set. USER is the invoking user
# (the sudoers rule names them); GROUP is the LLM user.
USER=${SUDO_USER:-}
[ -n "$USER" ] || {
    echo "aishare-helper: SUDO_USER is not set: run via sudo as the sharing user" >&2
    exit 1
}
GROUP=ai

usage() {
    echo "usage: aishare-helper chown [-R|-h] PATH... | aishare-helper chown PATH | aishare-helper chattr +i|-i PATH..." >&2
    exit 1
}

# safe_path: 0 iff PATH's lexical form stays under /home/$GROUP and no
# component of it is a symlink. A missing final component is fine: the
# state-file chown batch names files that usually do not exist yet.
safe_path() {
    [ -n "$1" ] || return 1
    sp_p=$(realpath -sm -- "$1" 2>/dev/null) || return 1
    case "$sp_p" in
        "/home/$GROUP"|"/home/$GROUP"/*) ;;
        *) return 1 ;;
    esac
    sp_rest="$sp_p"
    sp_acc=""
    while [ -n "$sp_rest" ]; do
        case "$sp_rest" in
            */*) sp_c="${sp_rest%%/*}"; sp_rest="${sp_rest#*/}" ;;
            *)   sp_c="$sp_rest";        sp_rest="" ;;
        esac
        [ -n "$sp_c" ] || continue
        sp_acc="$sp_acc/$sp_c"
        [ -L "$sp_acc" ] && return 1
    done
    return 0
}

# Refuse the whole operation if any path fails (fail closed: a planted
# symlink in a batch is a signal, not something to work around).
check_paths() {
    for sp_p in "$@"; do
        case "$sp_p" in
            -*) echo "aishare-helper: refusing: bad argument $sp_p" >&2; exit 1 ;;
        esac
        # Refuse '..' components in the raw argument: realpath -sm normalizes
        # them lexically without following symlinks, but the kernel resolves
        # a '..' after a symlink component to the target's parent, so
        # /home/$GROUP/x/.. with a planted 'x -> /' would pass the lexical
        # and symlink checks yet reach / when the operation runs.
        case "$sp_p" in
            ..|../*|*/..|*/../*)
                echo "aishare-helper: refusing: $sp_p contains a '..' component" >&2
                exit 1
                ;;
        esac
        safe_path "$sp_p" || {
            echo "aishare-helper: refusing: $sp_p is outside /home/$GROUP or has a symlink component" >&2
            exit 1
        }
    done
}

[ $# -ge 2 ] || usage
op="$1"
shift
case "$op" in
    chown)
        mode=""
        case "$1" in
            -R|-h) mode="$1"; shift ;;
        esac
        [ $# -ge 1 ] || usage
        # Plain form is the home-dir chown: exactly one path, so a caller
        # cannot smuggle an owner:group operand (chown would parse its first
        # operand as the identity). -R/-h inject the identity themselves.
        [ -n "$mode" ] || [ $# -eq 1 ] || usage
        check_paths "$@"
        ;;
    chattr)
        [ $# -ge 2 ] || usage
        case "$1" in
            +i|-i) ;;
            *) usage ;;
        esac
        flag="$1"
        shift

        check_paths "$@"
        ;;
    stop|cont)
        [ $# -ge 1 ] || usage
        # Each PID must be numeric and owned by $GROUP.

        for sp_pid in "$@"; do
            case "$sp_pid" in
                *[!0-9]*) echo "aishare-helper: refusing: not a PID: $sp_pid" >&2; exit 1 ;;
            esac
            sp_uid=$(stat -c %U "/proc/$sp_pid" 2>/dev/null)
            if [ -z "$sp_uid" ]; then
                echo "aishare-helper: refusing: PID $sp_pid does not exist" >&2; exit 1
            fi
            [ "$sp_uid" = "$GROUP" ] || {
                echo "aishare-helper: refusing: PID $sp_pid is owned by $sp_uid, not $GROUP" >&2; exit 1
            }
        done
        ;;
    *) usage ;;
esac

[ "$(id -u)" = 0 ] || {
    echo "aishare-helper: must be run as root (via sudo)" >&2
    exit 1
}

case "$op" in
    chown)
        case "$mode" in
            -R) exec /usr/bin/chown -R "$USER:$GROUP" "$@" ;;
            -h) exec /usr/bin/chown -h "$GROUP:$GROUP" "$@" ;;
            # -h: identical for the regular files aishare passes (the home
            # dir, planted hooks); a symlink swapped in between validation
            # and exec is chowned itself, never its target.
            *)  exec /usr/bin/chown -h "$USER:$GROUP" "$@" ;;
        esac
        ;;

    chattr)
        exec /usr/bin/chattr "$flag" "$@"
        ;;    stop)
        for sp_pid in "$@"; do kill -STOP "$sp_pid" 2>/dev/null; done
        ;;
    cont)
        for sp_pid in "$@"; do kill -CONT "$sp_pid" 2>/dev/null; done
        ;;
esac

